{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawmotion.ai/schemas/event-envelope.v1.json",
  "title": "PawMotion AI Event Envelope",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "aggregateId", "correlationId", "causationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "pattern": "^[A-Z][A-Za-z]+(Recorded|Created|Updated|Completed|Issued|Redeemed|Generated)\\.v[0-9]+$" },
    "eventVersion": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": ["string", "null"], "format": "uuid" },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
