# Local development values. Replace before any shared or production deployment.
POSTGRES_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/pawmotion
DB_USERNAME=pawmotion
JWT_SECRET=replace-with-at-least-32-random-bytes-for-local-demo-only
JWT_ISSUER=paw-motion-ai
JWT_TTL_SECONDS=3600
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated upstream proxy CIDRs trusted by frontend Nginx to derive visitor IPs.
TRUSTED_PROXY_CIDRS=
# Comma-separated proxy IPs/CIDRs trusted by the backend when reading X-Forwarded-For.
TRUSTED_PROXIES=
VITE_API_BASE_URL=
