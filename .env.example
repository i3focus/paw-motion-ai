# Local development values. Replace before any shared or production deployment.
POSTGRES_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/pawmotion
DB_USERNAME=pawmotion
JWT_SECRET=replace-with-at-least-32-random-bytes-for-local-demo-only
JWT_ISSUER=paw-motion-ai
JWT_TTL_SECONDS=3600
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated upstream proxy CIDRs trusted by frontend Nginx to derive visitor IPs.
TRUSTED_PROXY_CIDRS=
# Comma-separated proxy IPs/CIDRs trusted by the backend when reading X-Forwarded-For.
TRUSTED_PROXIES=
VITE_API_BASE_URL=

# Partner credits, billing, and campaign pricing (Slice 6)
BILLING_CURRENCY=BRL
BILLING_CREDITS_PER_CURRENCY_UNIT=10
BILLING_MIN_PURCHASE_AMOUNT=10.00
BILLING_MAX_PURCHASE_AMOUNT=10000.00
PAYMENT_PROVIDER=fake
BILLING_PENDING_TTL=24h
PARTNER_PORTAL_BASE_URL=http://localhost:5173/partner
FAKE_WEBHOOK_SECRET=replace-with-random-fake-webhook-secret
CAMPAIGN_PRICE_AMOUNT=50.00
CAMPAIGN_CREATION_COST_CREDITS=500
CAMPAIGN_DURATION_DAYS=30
# AbacatePay is only required when PAYMENT_PROVIDER=abacatepay
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_CREDIT_PRODUCT_EXTERNAL_ID=pawmotion-credits-brl
