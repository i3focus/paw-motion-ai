# Nginx do backend: unica porta de entrada da app Spring Boot. Aceita apenas /api/ e somente de
# frontend nginx (172.28.0.10) e gateway (172.28.0.3); o backend confia apenas neste proxy.
set_real_ip_from 172.28.0.10;
set_real_ip_from 172.28.0.3;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

server {
  listen 80;
  server_name _;

  location /api/ {
    proxy_pass http://backend:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  location / {
    return 404;
  }
}
