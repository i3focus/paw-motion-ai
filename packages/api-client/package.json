{
  "name": "@petlife/api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PETLIFE API types generated from docs/api/openapi.yaml plus a small fetch helper. Consumed by the web and Expo apps via file: dependencies.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.d.ts"
  },
  "scripts": {
    "generate": "./scripts/generate.sh",
    "typecheck": "tsc --noEmit --strict src/index.ts src/schema.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.6.0"
  }
}
